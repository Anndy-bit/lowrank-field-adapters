\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Peak memory and trainable parameters (Qwen2.5-7B, 15.2\,GB on disk). Three memory measures are reported: \emph  {alloc} is the peak of the PyTorch allocator, \emph  {resv} additionally counts blocks the caching allocator retains, and \emph  {smi} is total device occupancy including the CUDA context---the strictest measure, and the one that must fit. Perplexity is measured on 100 held-out Alpaca examples, identical data and seed across rows.}}{6}{table.4}\protected@file@percent }
\newlabel{tab:vram}{{IV}{6}{Peak memory and trainable parameters (Qwen2.5-7B, 15.2\,GB on disk). Three memory measures are reported: \emph {alloc} is the peak of the PyTorch allocator, \emph {resv} additionally counts blocks the caching allocator retains, and \emph {smi} is total device occupancy including the CUDA context---the strictest measure, and the one that must fit. Perplexity is measured on 100 held-out Alpaca examples, identical data and seed across rows}{table.4}{}}
\newlabel{tab:vram@cref}{{[table][4][]IV}{[1][6][]6}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Device memory over the full 4\,h\,16\,min run of Qwen2.5-7B (114\,766 samples at 100\,ms). The sawtooth is \Cref  {alg:usf} itself: each tooth is one $\textsc  {Load}$--compute--$\textsc  {Free}$ cycle of a 0.43\,GB decoder layer. The model is 15.2\,GB on disk, yet nothing approaches the card's 4034\,MB---the picture \Cref  {thm:vram} predicts. The upward drift of the reserved curve is the caching allocator retaining freed blocks, not growth in what USF{} keeps resident.}}{6}{figure.2}\protected@file@percent }
\newlabel{fig:vram}{{2}{6}{Device memory over the full 4\,h\,16\,min run of Qwen2.5-7B (114\,766 samples at 100\,ms). The sawtooth is \Cref {alg:usf} itself: each tooth is one $\textsc {Load}$--compute--$\textsc {Free}$ cycle of a 0.43\,GB decoder layer. The model is 15.2\,GB on disk, yet nothing approaches the card's 4034\,MB---the picture \Cref {thm:vram} predicts. The upward drift of the reserved curve is the caching allocator retaining freed blocks, not growth in what \usf {} keeps resident}{figure.2}{}}
\newlabel{fig:vram@cref}{{[figure][2][]2}{[1][6][]6}}
